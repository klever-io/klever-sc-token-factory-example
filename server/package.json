{
  "name": "token-factory-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Node.js que integra com o smart contract TokenFactory na Klever usando klever-connect",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:contract": "tsx scripts/deploy.ts",
    "demo": "tsx scripts/demo.ts",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "demo:sft": "tsx scripts/demo-sft.ts"
  },
  "dependencies": {
    "@klever/connect": "^0.1.9",
    "@klever/connect-crypto": "^0.2.0",
    "@klever/connect-provider": "^0.2.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
