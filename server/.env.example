# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000

# Espera a confirmação on-chain antes de responder (pode ser sobreposto por
# requisição com "wait": true|false no corpo).
WAIT_FOR_TX=true

# ── Rede Klever ──────────────────────────────────────────────────────────────
# mainnet | testnet | devnet | local
KLEVER_NETWORK=testnet

# ── Contrato ─────────────────────────────────────────────────────────────────
# Endereço do TokenFactory já deployado (npm run deploy:contract imprime).
CONTRACT_ADDRESS=

# Artefatos gerados por `~/klever-sdk/ksc all build` no diretório do contrato.
ABI_PATH=../token-factory/output/token-factory.abi.json
WASM_PATH=../token-factory/output/token-factory.wasm

# ── Carteira ─────────────────────────────────────────────────────────────────
# Arquivo PEM (formato Klever, o mesmo do koperator / kleverchain) da conta que
# assina as transações do backend. Caminho relativo à pasta backend/.
# Sem ele o servidor sobe em modo somente-leitura. Gere um com: npm run wallet:new
WALLET_PEM_PATH=./walletKey.pem
# Só se o PEM foi gerado criptografado.
# WALLET_PEM_PASSWORD=
