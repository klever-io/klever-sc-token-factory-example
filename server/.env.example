# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Listen interface. Keep 127.0.0.1: the server signs transactions with the
# wallet below and has no authentication. Using 0.0.0.0 (or a network IP)
# lets anyone who can reach the port deploy, mint, burn, etc.
HOST=127.0.0.1

# Waits for on-chain confirmation before responding (can be overridden per
# request with "wait": true|false in the body).
WAIT_FOR_TX=true

# ── Klever network ───────────────────────────────────────────────────────────
# mainnet | testnet | devnet | local
KLEVER_NETWORK=testnet

# ── Contract ─────────────────────────────────────────────────────────────────
# Address of the already deployed TokenFactory (printed by npm run deploy:contract).
CONTRACT_ADDRESS=

# Artifacts generated by `~/klever-sdk/ksc all build` in the contract directory.
ABI_PATH=../token-factory/output/token-factory.abi.json
WASM_PATH=../token-factory/output/token-factory.wasm

# ── Wallet ───────────────────────────────────────────────────────────────────
# PEM file (Klever format, the same as koperator / kleverchain) of the account
# that signs the backend's transactions. Path relative to the server/ folder.
# Without it the server starts in read-only mode. Generate one with: npm run wallet:new
WALLET_PEM_PATH=./walletKey.pem
# Only if the PEM was generated encrypted.
# WALLET_PEM_PASSWORD=
